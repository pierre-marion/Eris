+      .trim()
+      .split("\n")
+      .filter(Boolean);
+    const systemBin = candidates.find((p) => !p.includes("node_modules"));
+    if (systemBin) return systemBin;
+    throw new Error("no non-node_modules ngrok on PATH");
+  } catch (e) {
+    return require("@expo/ngrok-bin");
