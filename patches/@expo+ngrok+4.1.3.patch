+// `which`/`where` must skip node_modules/.bin shims (npx puts it first on PATH,
+// so it would otherwise shadow a real global install with the same ancient binary).
+function resolveBin() {
+  if (process.env.EXPO_NGROK_BIN) return process.env.EXPO_NGROK_BIN;
+  try {
+    const finder = process.platform === "win32" ? "where" : "which";
+    const candidates = execFileSync(finder, ["-a", "ngrok"], { stdio: ["ignore", "pipe", "ignore"] })
